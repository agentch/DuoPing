{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoPing",
  "version": "0.1.0",
  "identifier": "com.duoping.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DuoPing",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Duolingo 每日 XP 提醒",
    "longDescription": "DuoPing 是一款轻量的非官方 Duolingo 每日 XP 检查与提醒工具。",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}

